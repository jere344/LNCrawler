CREATE TEMP TABLE _nfs_map AS
    SELECT id AS old_id, (row_number() OVER (ORDER BY id))::bigint AS new_id
    FROM lncrawler_api_novelfromsource;
CREATE FUNCTION pg_temp.nfs_map(uuid) RETURNS bigint LANGUAGE sql STABLE AS
$$ SELECT new_id FROM _nfs_map WHERE old_id = $1 $$;

