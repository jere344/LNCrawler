# Copy to .env (gitignored) and fill in the required values. Every value shown is the default unless marked required.

# -- required -------------------------------------------------------------------
# Base URL of lncrawler (the worker appends /api/audiobook-worker/).
LNCRAWLER_URL=https://lncrawler.example.test
# Token from `manage.py create_audiobook_worker <user>` on lncrawler.
WORKER_TOKEN=replace-with-the-worker-token
# A stable id for this machine, e.g. gtx1080-home.
WORKER_ID=worker-1

# -- what this worker claims ----------------------------------------------------
# Engine profile for new parts: qwen-mixed or kokoro. A part keeps the profile it started with.
WORKER_PROFILE=qwen-mixed
# Comma-separated language codes this worker claims (at most 20).
WORKER_LANGUAGES=en

# -- Castwright (the TTS and audio stack, tools/castwright) ----------------------
# Castwright on the compose network.
CASTWRIGHT_URL=http://castwright:8080
# Recorded in each part's engine version. Change them when Castwright or hz is updated.
CASTWRIGHT_REF=3a52b28
HZ_REF=74feb58
# Lines a main character needs for a designed Qwen voice, and the cap on new designs per part.
QWEN_MAIN_MIN_LINES=20
QWEN_MAX_DESIGNED=10

# -- the local LLM (llama service, worker/llm.py) -------------------------------
# OpenAI-compatible base URL of llama-server.
LLM_URL=http://llama:8080/v1
# Seconds one LLM call may take (a full 4096-token reply is about 5 min on a GTX 1080) before the server is taken to be stalled and restarted.
LLM_TIMEOUT_S=600
# Seconds idle before llama-server sleeps. The worker waits this long before design. Compose passes it to llama
# as --sleep-idle-seconds, so change it here only.
LLM_IDLE_S=30
# File the worker writes to ask the llama container to restart its server. Empty turns the restart off.
LLM_RESTART_FLAG=/control/restart
# GGUF file in the llm-models volume that the llama service serves (read by docker-compose.yml).
LLM_GGUF=Qwen3.5-9B-MTP-Q4_K_M.gguf

# -- timing ---------------------------------------------------------------------
# Seconds between pings to lncrawler, heartbeats while a part runs, and the wait after a failed part or an empty claim.
PING_INTERVAL_S=300
HEARTBEAT_INTERVAL_S=60
IDLE_RETRY_S=300

# -- paths (fixed by docker-compose.yml; listed for reference) ------------------
# Where state, part folders, the series memory and the LLM usage log live (the worker-data volume).
DATA_DIR=/data
# Castwright's workspace mount, used only to delete uploaded chapter audio.
WORKSPACE_DIR=/workspace
