# Copy to `.env` and adjust for your deployment. docker compose reads it from this directory.

# --- Database ---
POSTGRES_DB=lncrawler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
SITE_URL=http://localhost
SITE_API_URL=http://api.localhost
# Generate with: django-admin startproject --generate-secret-key
SECRET_KEY=change-me
DEBUG=False
CORS_ALLOW_ALL_ORIGINS=False

# Admin superuser, created on first boot
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Email (password reset) ---
# Any SMTP provider works. Port 587 uses TLS, port 465 uses SSL: set only one to True.
EMAIL_HOST=smtp.mailpace.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_SENDER_NAME=LNCrawler

# --- Nginx ---
# Only edit SITE_URL / SITE_API_URL and this one; the other hosts are derived.
# Behind a TLS terminator (Caddy): keep the public URLs without a port and set
# NGINX_PORT to the port the terminator forwards to.
NGINX_PORT=80

# --- Crawler workers ---
# Number of job-worker containers (search + download). Also: docker compose up -d --scale crawler=N
CRAWLER_REPLICAS=2
# CRAWLER_CONCURRENCY=5        # max concurrent job subprocesses per container
# CRAWLER_POLL=2               # seconds to sleep when the queue is empty
# CRAWLER_STALE_MINUTES=10     # running jobs older than this are retried once, then failed
# CRAWLER_REQUEUE_EVERY=300    # seconds between stale-job requeues
# CRAWLER_MEM_LIMIT=2g         # container memory cap
# CRAWLER_CPUS=1.5             # CPU cap per replica, in cores
# CRAWLER_JOB_MEM_LIMIT_MB=0   # per-job memory cap; 0 = off (keep off if you use browser fallbacks)

# --- Scheduler ---
# Master switch for background maintenance. False stops it: run the commands by hand instead.
SCHEDULER_ENABLED=True
# LNCRAWL_PRUNE_APPLY=True     # False disables the scheduled destructive library prune

# --- Harvest feeder ---
# Enable it in the admin (Harvest configuration), not here.
# HARVEST_INTERVAL=20          # seconds between feeder loop iterations
# HARVEST_REFRESH_SECONDS=3600 # minimum gap between browse scans
# HARVEST_SCAN_TIMEOUT=1800    # seconds before a browse scan is killed

# --- LLM (novel dedup, tag merge, R18 tags) ---
# Optional: leave LLM_PROVIDERS empty to run without an LLM. Set the providers below.
# Daily and per-minute caps are set per provider (LLM_<NAME>_DAILY_REQUESTS and so on).
# Confidence (0..1) at which a confident LLM answer is applied without review.
# Below it, the answer waits for a human. Each kind has its own threshold.
# NOVEL_MERGE_AUTO_CONFIDENCE=0.95   # novel merge: "same" pairs merged automatically
# AUTHOR_MERGE_AUTO_CONFIDENCE=0.95  # author merge
# TAG_MERGE_AUTO_CONFIDENCE=0.95     # tag merge
# TAG_MERGE_MIN_CONFIDENCE=0.5       # tag merge: proposed sets below this are dropped
# Keep it at or below TAG_MERGE_AUTO_CONFIDENCE: above it, sets confident enough to apply would be dropped.
# TAG_R18_AUTO_CONFIDENCE=0.85       # R18 tags: explicit tags flagged adult
# TAG_BIG_TAG_USAGE=200              # tag merge: joining two tags used by more sources waits for review
# TAG_R18_REVIEW_NOVELS=10           # R18 tag on this many novels or more waits for review
# No longer read (rename them): MERGE_LLM_AUTO_CONFIDENCE -> NOVEL_MERGE_AUTO_CONFIDENCE,
# TAG_R18_LLM_MIN_CONFIDENCE -> TAG_R18_AUTO_CONFIDENCE. MERGE_LLM_DISMISS_CONFIDENCE and
# MERGE_LLM_DISMISS_MAX_CERTAINTY are gone: a confident "different" is now rejected at
# NOVEL_MERGE_AUTO_CONFIDENCE, whatever the certainty.

# Fallback chain. Providers are tried in order.
# Each provider reads LLM_<NAME>_API_KEY and LLM_<NAME>_MODEL (required), plus optional
# LLM_<NAME>_BASE_URL, _REASONING_EFFORT, _EXTRA_BODY (JSON merged into every request),
# _DAILY_REQUESTS, _DAILY_TOKENS, _REQUESTS_PER_MINUTE, _TOKENS_PER_MINUTE,
# _COOLDOWN (seconds, default 3600) and _JSON_SCHEMA (default true: replies follow the
# task's JSON schema; set false for a provider that rejects response_format).
# LLM_PROVIDERS=cloudflare,groq,gemini
# LLM_CLOUDFLARE_API_KEY=
# LLM_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1/chat/completions
# LLM_CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# LLM_CLOUDFLARE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# LLM_GROQ_API_KEY=
# LLM_GROQ_MODEL=openai/gpt-oss-20b
# LLM_GROQ_REASONING_EFFORT=low
# LLM_GROQ_COOLDOWN=60
# Google AI Studio (no card): gemini-3.5-flash-lite was the only free Gemini
# model that stayed available in tests; the larger flash models hit their free
# quota after about 10 calls.
# LLM_GEMINI_API_KEY=
# LLM_GEMINI_MODEL=gemini-3.5-flash-lite

# --- Tag merging (embeddings find translations and synonyms) ---
# Without a key the embedding signal is skipped; co-occurrence and trigram still run.
# EMBED_API_KEY=                 # free key at jina.ai
# EMBED_PROVIDER=jina            # jina, voyage, openai, or set EMBED_BASE_URL
# EMBED_MODEL=jina-embeddings-v5-omni-small   # changing it re-embeds every tag
# EMBED_BASE_URL=

# --- Error reporting ---
# Unexpected errors open a GitHub issue, deduplicated. The token needs issues write access.
GITHUB_REPO=jere344/LNCrawler
GITHUB_TOKEN=
GITHUB_ISSUES_ENABLED=False
# Or write one Markdown file per error under ISSUE_REPORTS_DIR instead
ISSUE_REPORTS_TO_DISK=False
ISSUE_REPORTS_DIR=

# --- Login-gated sources ---
# LNCRAWL_<KEY>_USERNAME / LNCRAWL_<KEY>_PASSWORD, KEY = the source's domain label, uppercased
# LNCRAWL_CYRISIA_USERNAME=
# LNCRAWL_CYRISIA_PASSWORD=

# Host folder where the downloaded library is stored
LIGHTNOVELS_PATH=./Lightnovels
