# Copy this file to `.env` and adjust the values for your deployment.
# `docker compose` reads `.env` automatically from this directory.

# --- Database ---
POSTGRES_DB=lncrawler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
SITE_URL=http://localhost
SITE_API_URL=http://api.localhost
# Generate one with: django-admin startproject --generate-secret-key
SECRET_KEY=change-me
DEBUG=False
CORS_ALLOW_ALL_ORIGINS=False

# --- Django admin superuser (created on first boot, changeable in the admin) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- SMTP email (password reset emails) ---
# MailPace: host smtp.mailpace.com, port 587 (STARTTLS default), and the
# domain's API token as both user and password. Any SMTP provider works.
EMAIL_HOST=smtp.mailpace.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_SENDER_NAME=LNCrawler

# --- Nginx ---
# Host port nginx is published on. Only edit SITE_URL / SITE_API_URL above and
# this; API_HOST, FRONTEND_HOST and VITE_API_BASE_URL are derived from them.
#
# In production nginx sits behind a TLS terminator (Caddy): leave the URLs on
# the public HTTPS port (no port) and set this to whatever the terminator
# forwards to (e.g. 8186). NGINX_PORT is the internal port, never a public one.
#
# Only when nginx is exposed directly (no TLS terminator) must the URLs carry
# this port too, e.g. http://api.localhost:8181, or the browser will hit an
# empty port and fail CORS.
NGINX_PORT=80

# --- Crawler workers ---
# Number of identical job-worker replicas (search + download). Scale up with
# usage. Overridable per run: docker compose up -d --scale crawler=N
CRAWLER_REPLICAS=2
# Each crawler runs a tiny supervisor that executes jobs in short-lived
# subprocesses (isolated, memory released on exit). Tune these if needed;
# defaults are fine for most deployments.
# CRAWLER_CONCURRENCY=5        # max concurrent job subprocesses per container
# CRAWLER_POLL=2               # seconds to sleep when the queue is empty
# CRAWLER_STALE_MINUTES=10     # jobs stuck running this long are retried once, then failed
# CRAWLER_REQUEUE_EVERY=300    # seconds between stale requeues
# CRAWLER_MEM_LIMIT=2g         # container cgroup cap (docker-compose.yml)
# CRAWLER_JOB_MEM_LIMIT_MB=0   # per-job RLIMIT_AS cap; 0 = disabled (Chromium
#                              # reserves large virtual memory, so keep disabled
#                              # unless you don't use browser fallbacks)

# --- Scheduled maintenance (scheduler service) ---
# Master switch for all background maintenance tasks (similarities, compression,
# view consolidation, popular-source refresh, library prune, job prune). Set to
# False to stop them entirely and run commands by hand instead. The scheduler
# container stays up and keeps cleaning stale locks.
SCHEDULER_ENABLED=True
# Set to False to skip the scheduled destructive library prune specifically
# (it still runs when False). Defaults to enabled.
# LNCRAWL_PRUNE_APPLY=True

# --- Harvest feeder (thread inside the scheduler service) ---
# The feeder discovers novels via each source's browse page and queues downloads.
# It runs as a thread inside the scheduler service, always running but doing
# nothing until enabled in the admin (Admin -> Harvest configuration -> Enable
# harvest); control it there, not here.
# HARVEST_INTERVAL=20          # seconds between feeder loop iterations
# HARVEST_REFRESH_SECONDS=3600 # minimum gap between browse scans
# HARVEST_SCAN_TIMEOUT=1800    # seconds before a browse scan is killed

# --- GitHub issue reporting for unexpected errors ---
# When enabled, every unexpected error (web, crawler, scheduler) opens a GitHub
# issue, deduplicated by fingerprint. GITHUB_TOKEN needs `issues:write` scope
# (classic PAT) or Issues read/write permission (fine-grained PAT).
GITHUB_REPO=jere344/LNCrawler
GITHUB_TOKEN=
GITHUB_ISSUES_ENABLED=False

# Local alternative: when True, write one Markdown file per fingerprint under
# ISSUE_REPORTS_DIR (default ./issue-reports) instead of opening a GitHub issue.
ISSUE_REPORTS_TO_DISK=False
ISSUE_REPORTS_DIR=

# --- Source accounts (login-gated sources) ---
# Variable names follow LNCRAWL_<KEY>_USERNAME / LNCRAWL_<KEY>_PASSWORD,
# where <KEY> is the source's canonical domain label, uppercased.
# LNCRAWL_CYRISIA_USERNAME=
# LNCRAWL_CYRISIA_PASSWORD=
