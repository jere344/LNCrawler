# Copy this file to `.env` and adjust the values for your deployment.
# `docker compose` reads `.env` automatically from this directory.

# --- Database ---
POSTGRES_DB=lncrawler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
SITE_URL=http://localhost
SITE_API_URL=http://api.localhost
# Generate one with: django-admin startproject --generate-secret-key
SECRET_KEY=change-me
DEBUG=False
CORS_ALLOW_ALL_ORIGINS=False

# --- Django admin superuser (created on first boot, changeable in the admin) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- SMTP email (password reset emails) ---
# MailPace: host smtp.mailpace.com, port 587 (STARTTLS default), and the
# domain's API token as both user and password. Any SMTP provider works.
EMAIL_HOST=smtp.mailpace.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_SENDER_NAME=LNCrawler

# --- Frontend build ---
VITE_API_BASE_URL=http://api.localhost

# --- Nginx ---
API_HOST=api.localhost
FRONTEND_HOST=localhost

# --- Crawler workers ---
# Number of identical job-worker replicas (search + download). Scale up with
# usage. Overridable per run: docker compose up -d --scale crawler=N
CRAWLER_REPLICAS=2

# --- GitHub issue reporting for unexpected errors ---
# When enabled, every unexpected error (web, crawler, scheduler) opens a GitHub
# issue, deduplicated by fingerprint. GITHUB_TOKEN needs `issues:write` scope
# (classic PAT) or Issues read/write permission (fine-grained PAT).
GITHUB_REPO=owner/LNCrawler
GITHUB_TOKEN=
GITHUB_ISSUES_ENABLED=False

# Local alternative: when True, write one Markdown file per fingerprint under
# ISSUE_REPORTS_DIR (default ./issue-reports) instead of opening a GitHub issue.
ISSUE_REPORTS_TO_DISK=False
ISSUE_REPORTS_DIR=

# --- Source accounts (login-gated sources) ---
# Variable names follow LNCRAWL_<KEY>_USERNAME / LNCRAWL_<KEY>_PASSWORD,
# where <KEY> is the source's canonical domain label, uppercased.
# LNCRAWL_CYRISIA_USERNAME=
# LNCRAWL_CYRISIA_PASSWORD=
