# Compress proxied responses (API JSON, frontend JS/CSS) at the edge.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types application/json application/javascript text/css text/plain text/xml application/xml image/svg+xml;

# Preserve the scheme set by the TLS terminator (Caddy) so Django can detect
# HTTPS via SECURE_PROXY_SSL_HEADER. Fall back to our own scheme on direct hits.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# The $render_seo crawler/social-bot map lives in a separate, auto-refreshed
# file (00-render-seo-map.conf) so the UA list can be updated without touching
# this template. See update-render-seo-map.sh.

# Disk cache for anonymous, shared API reads (home, search, novel list,
# autocomplete) and the SEO renderer. The server is RAM/CPU-poor but has disk:
# only the key index (10 MB) lives in memory. Logged-in requests (Token header
# or Django session cookie) always go to the API, so per-user fields stay exact.
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_cache:10m max_size=2g inactive=30m use_temp_path=off;
map "$http_authorization$cookie_sessionid" $api_private {
    ""      0;
    default 1;
}

server {
    listen 80;
    server_name ${API_HOST};

    # Resolve upstream names at request time so nginx starts even if the
    # api/frontend containers are briefly down or being recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Server-rendered SEO pages are an internal detail of the frontend host;
    # do not expose them as duplicate content on the API host.
    location /seo/ {
        return 404;
    }

    # Shared anonymous reads: cached briefly (see proxy_cache_path above).
    # Accept and Origin are in the key because the API varies on them.
    location ~ ^/novels/((home|search|autocomplete)/)?$ {
        set $api api:8000;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_cache api_cache;
        proxy_cache_key "$scheme$host$request_uri|$http_accept|$http_origin";
        proxy_cache_valid 200 60s;
        proxy_cache_bypass $api_private;
        proxy_no_cache $api_private;
        proxy_ignore_headers Vary;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout;
        add_header X-Cache $upstream_cache_status always;
    }

    # Proxy to API container
    location / {
        set $api api:8000;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Serve static files directly
    location /static/ {
        alias /static/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Serve media files directly
    location /media/ {
        alias /media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Serve lightnovels files directly
    location /lightnovels/ {
        alias /lightnovels/;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }
}

server {
    listen 80;
    server_name ${FRONTEND_HOST};

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Sitemap is generated by the API. Serve it on the frontend host so
    # robots.txt's same-host Sitemap: directive is honoured.
    location ~ ^/sitemap(-[a-z]+)?\.xml$ {
        set $api api:8000;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Server-rendered SEO pages are produced by the API. Internal only: crawlers
    # are rewritten here from the public content URLs, which stay unchanged.
    location /_seo/ {
        internal;
        # Crawler traffic is always anonymous, so the SEO renderer output is cached.
        proxy_cache api_cache; proxy_cache_key "$scheme$host$request_uri"; proxy_cache_valid 200 10m; proxy_ignore_headers Vary; proxy_cache_lock on; proxy_cache_use_stale updating error timeout;
        set $api api:8000;
        rewrite ^/_seo/(.*)$ /seo/$1 break;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Frontend application
    location / {
        # Send crawlers/social scrapers of content pages to the SEO renderer;
        # assets, robots.txt and other files still fall through to the SPA host.
        if ($render_seo) {
            rewrite ^(/novels/(?!search/?$)(?!.*/gallery/?$).*|/)$ /_seo$1 last;
        }
        set $frontend frontend:80;
        proxy_pass http://$frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
