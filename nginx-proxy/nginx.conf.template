# Compress proxied responses (API JSON, frontend JS/CSS) at the edge.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types application/json application/javascript text/css text/plain text/xml application/xml image/svg+xml;

# Preserve the scheme set by the TLS terminator (Caddy) so Django can detect
# HTTPS via SECURE_PROXY_SSL_HEADER. Fall back to our own scheme on direct hits.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name ${API_HOST};

    # Resolve upstream names at request time so nginx starts even if the
    # api/frontend containers are briefly down or being recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Proxy to API container
    location / {
        set $api api:8000;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Serve static files directly
    location /static/ {
        alias /static/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Serve media files directly
    location /media/ {
        alias /media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Serve lightnovels files directly
    location /lightnovels/ {
        alias /lightnovels/;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }
}

server {
    listen 80;
    server_name ${FRONTEND_HOST};

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Frontend application
    location / {
        set $frontend frontend:80;
        proxy_pass http://$frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
