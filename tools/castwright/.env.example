# Copy to .env in this folder. Castwright needs no LLM key: the analysis runs in the audiobook worker, on its local LLM
# (audiobook-worker/). Castwright's own analyzer is not used.

# nvidia (default) or cpu. Changing it means a rebuild.
# ACCEL=nvidia
# auto | cpu  (cpu forces the Kokoro CPU path)
# KOKORO_DEVICE=auto

# CW_PORT=18080
# CW_MEM_LIMIT=3g
# CW_CPUS=2

# Qwen on the 8 GB PC (docker-compose.qwen.yml). Defaults are in the README.
# QWEN_17B_BACKEND=hz
# KOKORO_ORT_GPU_MEM_MB=3072
# SIDECAR_VRAM_RECYCLE_SOFT_MB=8200
