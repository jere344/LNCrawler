# Copy to .env (bench only, never the prod .env).

# Character analysis runs on Gemini/Gemma free tier (no local LLM on a 4 GB card).
# https://aistudio.google.com/
GEMINI_API_KEY=
# Gemma avoids Gemini's recitation filter on copyrighted chapters.
GEMINI_MODEL=gemma-4-31b-it

# Folder holding <novel>/<source>/json/NNNNN.json (prod: the LIGHTNOVELS_PATH folder).
# NOVELS_DIR=../../Lightnovels

# nvidia (default) or cpu. Changing it means a rebuild.
# ACCEL=nvidia
# auto | cpu  (cpu forces the Kokoro CPU path for the comparison run)
# KOKORO_DEVICE=auto

# CW_PORT=18080
# CW_MEM_LIMIT=3g
# CW_CPUS=2
